{
  "manifest_version": 3,
  "name": "ТСН Менеджер (beta)",
  "version": "4.5.4",
  "description": "Автоматично ставить рекламу в паузах та запускає ефіри за вашим розкладом.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "windows",
    "notifications",
    "scripting",
    "identity",
    "identity.email"
  ],
  "host_permissions": [
    "https://studio.youtube.com/*",
    "https://script.google.com/*",
    "https://script.googleusercontent.com/*"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://studio.youtube.com/*"
      ],
      "js": [
        "src/config.js",
        "src/utils.js",
        "src/analyzer.js",
        "src/render.js",
        "src/injector.js",
        "src/valera_cloud.js",
        "src/ui.js",
        "src/init.js",
        "src/scheduler.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "inject.js",
        "media/figure_dark.mp4",
        "media/figure_atlas.webp"
      ],
      "matches": [
        "https://studio.youtube.com/*"
      ]
    }
  ],
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "TSN manager"
  }
}